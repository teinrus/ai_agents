# Локальный запуск. Файл .env в репозиторий не входит.
LLM_ADAPTER=mock
MEMORY_BACKEND=memory
ENABLED_ROLES=mail
# Вторая роль: records. Несколько ролей перечисляются через запятую.
PLATFORM_RISK_CEILING=act
PLATFORM_DEBUG_EVENTS=false
# Сколько последних сообщений треда видит приёмная при разборе
PLATFORM_DIALOG_HISTORY_LIMIT=12

# Нужны только при LLM_ADAPTER=local
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_MODEL=local-model

# Нужны только при LLM_ADAPTER=cloud
# CLOUD_LLM_BASE_URL=https://api.openai.com/v1
# CLOUD_LLM_API_KEY=
# CLOUD_LLM_MODEL=cloud-model

# Живой каталог перечитывает JSON на каждом выборе модели
# MODEL_CATALOG_SOURCE=live
# MODEL_CATALOG_PATH=data/catalog.json

# Внешний журнал конвертов. Пусто — брокер выключен
# BROKER_PATH=data/events.log

# Нужны только при MEMORY_BACKEND=shared
# MEMORY_SHARED_PATH=data/shared

# Нужны только при MEMORY_BACKEND=sqlite
# MEMORY_SQLITE_PATH=data/memory.db

# Нужны только при MAILBOX_BACKEND=imap
# MAILBOX_BACKEND=memory
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
